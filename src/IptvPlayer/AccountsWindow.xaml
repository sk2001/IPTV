<Window x:Class="IptvPlayer.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comptes IPTV" Width="820" Height="560" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,14">
                <TextBlock DockPanel.Dock="Top" Text="Mes comptes" FontSize="16" FontWeight="SemiBold" Margin="18,0,18,10"/>
                <Button DockPanel.Dock="Bottom" Content="＋  Nouveau compte" Style="{StaticResource AccentButton}" Margin="14,10,14,0" Click="New_Click"/>
                <ListBox x:Name="AccountList" SelectionChanged="AccountList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,22">
                <TextBlock x:Name="FormTitle" Text="Nouveau compte" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

                <TextBlock Text="Nom du compte" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox"/>

                <TextBlock Text="Type" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="XtreamRadio" Content="Xtream Codes" IsChecked="True" Margin="0,0,24,0" Checked="Type_Changed"/>
                    <RadioButton x:Name="M3uRadio" Content="Playlist M3U" Checked="Type_Changed"/>
                </StackPanel>

                <TextBlock x:Name="UrlLabel" Text="URL du serveur (http://hote:port)" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0" Visibility="Collapsed" Click="Browse_Click"/>
                </Grid>

                <StackPanel x:Name="CredsPanel">
                    <TextBlock Text="Nom d'utilisateur" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,5"/>
                    <TextBox x:Name="UserBox"/>
                    <TextBlock Text="Mot de passe" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,5"/>
                    <PasswordBox x:Name="PassBox"/>
                </StackPanel>

                <TextBlock x:Name="Message" Margin="0,16,0,0" TextWrapping="Wrap" MinHeight="20"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="TestBtn" Content="Tester" Click="Test_Click" Margin="0,0,10,0" MinWidth="90"/>
                    <Button Content="Enregistrer" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,10,0" MinWidth="110"/>
                    <Button x:Name="DeleteBtn" Content="Supprimer" Click="Delete_Click" Margin="0,0,10,0" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
                    <Button Content="Fermer" Click="Close_Click" MinWidth="80"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
