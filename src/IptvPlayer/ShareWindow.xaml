<Window x:Class="IptvPlayer.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IptvPlayer.Localization"
        Title="{loc:T share.title}" Icon="Assets/app.ico" Width="460" Height="640" MinWidth="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="{loc:T share.title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{loc:T share.note}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Background="White" CornerRadius="10" Padding="12" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <TextBlock x:Name="AddressText" FontSize="18" HorizontalAlignment="Center" Margin="0,14,0,2"/>
        <TextBlock x:Name="PinText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:T share.valid}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,12"/>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Text="{loc:T share.firewall}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>

        <Button Content="{loc:T set.close}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="100" IsDefault="True" Click="Close_Click"/>
    </StackPanel>
</Window>
