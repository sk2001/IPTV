<Window x:Class="IptvPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Icon="Assets/app.ico" Width="680" Height="700" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26,32,10">
                <TextBlock Text="Paramètres" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Les changements s'appliquent à la prochaine lecture." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22"/>

                <TextBlock Text="LANGUE AUDIO — FILMS ET SÉRIES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Piste audio choisie automatiquement quand le flux en propose plusieurs (VF / VO…)." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="AudioVodChips" Margin="0,0,0,18"/>

                <TextBlock Text="SOUS-TITRES — FILMS ET SÉRIES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Activés seulement si une piste de sous-titres dans cette langue existe." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="SubVodChips" Margin="0,0,0,18"/>

                <TextBlock Text="LANGUE AUDIO — CHAÎNES LIVE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="« Auto » laisse le flux décider (recommandé pour les chaînes locales)." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="AudioLiveChips" Margin="0,0,0,18"/>

                <TextBlock Text="REPRISE DE LA LECTURE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Reprendre un film ou un épisode là où tu t'étais arrêté." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="ResumeChips" Margin="0,0,0,18"/>

                <TextBlock Text="HISTORIQUE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="HistoryInfo" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="Effacer l'historique…" Click="ClearHistory_Click" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>

                <TextBlock Text="COMPTES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Gérer les comptes…" Click="Accounts_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <Button Content="Fermer" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="100" IsDefault="True" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
