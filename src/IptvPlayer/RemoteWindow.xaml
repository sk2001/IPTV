<Window x:Class="IptvPlayer.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IptvPlayer.Localization"
        Title="{loc:T rem.title}" Icon="Assets/app.ico" Width="560" Height="680" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,20">
            <TextBlock Text="{loc:T rem.title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{loc:T rem.note}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <!-- Télécommande de l'appareil sélectionné -->
            <Border x:Name="ControlPanel" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="TargetName" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TargetStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,12"/>
                    <WrapPanel>
                        <Button Content="⏮" Click="Prev_Click" MinWidth="44" Margin="0,0,6,6"/>
                        <Button Content="−10 s" Click="Back10_Click" Margin="0,0,6,6"/>
                        <Button x:Name="ToggleBtn" Content="▶ / ⏸" Style="{StaticResource AccentButton}" Click="Toggle_Click" MinWidth="64" Margin="0,0,6,6"/>
                        <Button Content="+10 s" Click="Fwd10_Click" Margin="0,0,6,6"/>
                        <Button Content="⏭" Click="Next_Click" MinWidth="44" Margin="0,0,6,6"/>
                        <Button Content="⏹" Click="StopRemote_Click" MinWidth="44" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="🔉 −" Click="VolDown_Click" Margin="0,0,6,6"/>
                        <Button Content="🔊 +" Click="VolUp_Click" Margin="0,0,6,6"/>
                        <Button Content="{loc:T rem.mute}" Click="Mute_Click" Margin="0,0,6,6"/>
                        <Button Content="{loc:T rem.audio}" Click="Audio_Click" Margin="0,0,6,6"/>
                        <Button Content="{loc:T rem.subs}" Click="Subs_Click" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <Button Content="{loc:T rem.sync}" Click="Sync_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SyncText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="AutoText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <CheckBox x:Name="AutoSyncBox" Content="{loc:T rem.autoSync}" Margin="0,8,0,0" Checked="AutoSync_Changed" Unchecked="AutoSync_Changed"/>
                    <CheckBox x:Name="SyncAccountsBox" Content="{loc:T rem.syncAccounts}" Margin="0,10,0,0" Checked="SyncAccounts_Changed" Unchecked="SyncAccounts_Changed"/>
                    <Button Content="{loc:T rem.back}" Click="Disconnect_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ListsPanel">
                <TextBlock Text="{loc:T rem.paired}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,8"/>
                <StackPanel x:Name="PairedList" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T rem.nearby}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="SearchText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel x:Name="NearbyList" Margin="0,0,0,10"/>
                <Button Content="{loc:T rem.rescan}" Click="Rescan_Click" HorizontalAlignment="Left" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T rem.manual}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="{loc:T rem.pair}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ManualPair_Click"/>
                    <TextBox x:Name="ManualBox" Padding="6,4" ToolTip="192.168.1.20:47231"/>
                </DockPanel>
            </StackPanel>

            <!-- Saisie du PIN affiché par la cible -->
            <Border x:Name="PinPanel" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="PinPrompt" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button Content="{loc:T rem.pair}" Style="{StaticResource AccentButton}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PinOk_Click" IsDefault="True"/>
                        <TextBox x:Name="PinBox" MaxLength="6" FontSize="20" Padding="6,4"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Message" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
