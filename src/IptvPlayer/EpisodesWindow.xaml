<Window x:Class="IptvPlayer.EpisodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IptvPlayer.Localization"
        Title="{loc:T ep.title}" Icon="Assets/app.ico" Width="560" Height="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>
        <ListBox x:Name="List" Grid.Row="1" Background="{StaticResource SurfaceBrush}" MouseDoubleClick="List_DoubleClick">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="14,14,0,6">
                                <TextBlock Text="{loc:T ep.season}" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Display}" Padding="4,8" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource AccentHoverBrush}"
                                   VerticalAlignment="Center" Margin="12,0,6,0" FontSize="12"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="{loc:T ep.toggle}" HorizontalAlignment="Left" Click="Toggle_Click"
                    ToolTip="{loc:T ep.toggle.tip}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T ep.cancel}" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="90"/>
                <Button x:Name="PlayButton" Content="{loc:T ep.play}" Style="{StaticResource AccentButton}" Click="Play_Click" MinWidth="100" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
