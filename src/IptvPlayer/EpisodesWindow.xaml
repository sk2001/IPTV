<Window x:Class="IptvPlayer.EpisodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Épisodes" Icon="Assets/app.ico" Width="520" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>
        <ListBox x:Name="List" Grid.Row="1" Background="{StaticResource SurfaceBrush}" MouseDoubleClick="List_DoubleClick">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat=Saison {0}}" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentHoverBrush}" Margin="14,14,0,6"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" Padding="4,8" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="90"/>
            <Button Content="Lire" Style="{StaticResource AccentButton}" Click="Play_Click" MinWidth="90" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
