<Window x:Class="IptvPlayer.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IptvPlayer.Localization"
        Title="{loc:T lic.title}" Icon="Assets/app.ico" Width="920" Height="740" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="Tabs" Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <!-- Fichiers Markdown (.md) : rendu mis en forme -->
            <RichTextBox x:Name="MdViewer" IsReadOnly="True" IsDocumentEnabled="True" Visibility="Collapsed"
                         Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                         VerticalScrollBarVisibility="Auto" Padding="0"/>
            <!-- Autres fichiers : texte brut -->
            <TextBox x:Name="Viewer" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="16,14"/>
        </Grid>
    </Grid>
</Window>
