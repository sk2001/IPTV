<Window x:Class="IptvPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:m="clr-namespace:IptvPlayer.Models"
        xmlns:local="clr-namespace:IptvPlayer"
        xmlns:ctl="clr-namespace:IptvPlayer.Controls"
        Title="IPTV Player" Width="1360" Height="820" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:ImageUrlConverter x:Key="ImgConv"/>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <DataTemplate x:Key="GuideRowTemplate" DataType="{x:Type m:GuideRow}">
            <Grid Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Surface2Brush}" ClipToBounds="True">
                        <Image Source="{Binding Channel.Logo, Converter={StaticResource ImgConv}, IsAsync=True}"
                               Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="LowQuality"/>
                    </Border>
                    <TextBlock Text="{Binding Channel.Name}" Width="148" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ctl:GuideStrip Grid.Column="1" Entries="{Binding Entries}"
                                ViewStart="{Binding DataContext.GuideStart, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Clock="{Binding DataContext.ClockNow, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type m:MediaItem}">
            <Grid Height="54">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="{StaticResource Surface2Brush}" ClipToBounds="True">
                    <Image Source="{Binding Logo, Converter={StaticResource ImgConv}, IsAsync=True}"
                           Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="LowQuality"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,6,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                    <TextBlock Text="{Binding SubText}" FontSize="11" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Maximum="1" Height="2" Margin="0,3,6,0" Background="{StaticResource LineBrush}"
                                 Value="{Binding NowProgress, Mode=OneWay}"
                                 Visibility="{Binding HasNow, Converter={StaticResource B2V}}"/>
                </StackPanel>
                <ToggleButton Grid.Column="2" Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                              Click="Star_Click" ToolTip="Favori"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryTemplate" DataType="{x:Type m:Category}">
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavCol" Width="80"/>
            <ColumnDefinition x:Name="CatCol" Width="230"/>
            <ColumnDefinition x:Name="ListCol" Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border x:Name="NavPane" Background="{StaticResource SurfaceBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Live" Tag="&#xE7F4;" IsChecked="{Binding IsLive, Mode=TwoWay}" GroupName="nav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Guide" Tag="&#xE787;" IsChecked="{Binding IsGuideNav, Mode=TwoWay}" GroupName="nav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Films" Tag="&#xE714;" IsChecked="{Binding IsMovies, Mode=TwoWay}" GroupName="nav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Séries" Tag="&#xE8F1;" IsChecked="{Binding IsSeries, Mode=TwoWay}" GroupName="nav"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Enreg." Tag="&#xE74E;" IsChecked="{Binding IsRecordingsNav, Mode=TwoWay}" GroupName="nav"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Actualiser le catalogue"
                            Command="{Binding RefreshCommand}" Foreground="{StaticResource MutedBrush}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Comptes"
                            Click="Accounts_Click" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Catégories -->
        <Border x:Name="CatPane" Grid.Column="1" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecordings}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button x:Name="AccountButton" DockPanel.Dock="Top" Margin="10,12,10,8" Padding="12,9" Click="AccountButton_Click" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="COMPTE" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding SelectedAccount.Name, FallbackValue='Aucun compte'}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </Button>
                <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       Width="{Binding ActualWidth, ElementName=AccountButton}">
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="4" Margin="0,4,0,12" MaxHeight="320">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                     SelectionChanged="AccountList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Padding="4,8" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Gérer les comptes…" Margin="4,4,4,2" Click="Accounts_Click" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         ItemTemplate="{StaticResource CategoryTemplate}"/>
            </DockPanel>
        </Border>

        <!-- Liste des contenus -->
        <Border x:Name="ListPane" Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlayerHidden}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="12,12,12,6">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,9,10,9"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Rechercher…" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="35,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ProgressBar Grid.Row="1" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Grid Grid.Row="2">
                    <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemTemplate}"
                             KeyDown="ItemList_KeyDown" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                           Margin="14,8" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Guide TV (remplace la liste + le lecteur) -->
        <Border x:Name="GuidePane" Grid.Column="2" Grid.ColumnSpan="2" Background="{StaticResource BgBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGuide}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,16,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Guide TV" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GuideDateText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="2 h plus tôt (Maj + molette, ←)"
                                Command="{Binding GuideShiftCommand}" CommandParameter="-120"/>
                        <Button Content="Maintenant" Margin="2,0" Command="{Binding GoToNowCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="2 h plus tard (Maj + molette, →)"
                                Command="{Binding GuideShiftCommand}" CommandParameter="120"/>
                        <Grid Width="250" Margin="18,0,0,0">
                            <TextBox x:Name="GuideSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Filtrer les chaînes…" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                       Margin="35,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=GuideSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="20,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CHAÎNES" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <ctl:GuideRuler Grid.Column="1" Height="30" ViewStart="{Binding GuideStart}"/>
                </Grid>

                <ProgressBar Grid.Row="2" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEpgLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Grid Grid.Row="3">
                    <ListBox x:Name="GuideList" Margin="14,4,14,10" ItemsSource="{Binding GuideRows}"
                             ItemTemplate="{StaticResource GuideRowTemplate}" VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewMouseWheel="GuideList_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <EventSetter Event="MouseDoubleClick" Handler="GuideRow_DoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="{Binding GuideEmptyText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="40" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Enregistrements (remplace catégories + liste + lecteur) -->
        <Border x:Name="RecPane" Grid.Column="1" Grid.ColumnSpan="3" Background="{StaticResource BgBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecordings}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="28,20,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Enregistrements" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecordingsDir}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Ouvrir le dossier" Click="OpenRecDir_Click" Margin="0,0,8,0"/>
                        <Button Content="Changer le dossier…" Click="ChooseRecDir_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12">
                    <Grid>
                        <ListBox x:Name="RecList" ItemsSource="{Binding Recordings}" Margin="0,8" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <EventSetter Event="MouseDoubleClick" Handler="RecItem_DoubleClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:RecordingFile}">
                                    <Grid Height="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                                            <TextBlock Text="● enregistrement en cours" FontSize="11" Foreground="{StaticResource DangerBrush}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Lire" Click="RecPlay_Click"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Supprimer" Click="RecDelete_Click"
                                                    Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding RecordingsEmptyText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center" LineHeight="22" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Lecteur VLC -->
        <vlc:VideoView x:Name="Video" Grid.Column="3" Background="Black">
            <vlc:VideoView.Style>
                <Style TargetType="vlc:VideoView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlayerHidden}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </vlc:VideoView.Style>
            <Grid x:Name="Overlay" Background="#01000000" Focusable="True">
                <StackPanel x:Name="Idle" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="72"
                               Foreground="#2A323D" HorizontalAlignment="Center"/>
                    <TextBlock Text="Double-cliquez sur un contenu pour le lire" Foreground="#8B98A9" FontSize="14"
                               Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="BufferText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <Border x:Name="RecBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0"
                        Background="#B3000000" CornerRadius="14" Padding="12,5" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecBlink" Width="9" Height="9" Fill="#F85149" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecText" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border x:Name="TopBar" VerticalAlignment="Top" Padding="22,18,22,34" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" Foreground="#C8D1DC" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border x:Name="Controls" VerticalAlignment="Bottom" Padding="16,36,16,12" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#D9000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid x:Name="SeekRow" Margin="4,0,4,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeText" Foreground="White" FontSize="12" VerticalAlignment="Center" MinWidth="48"/>
                            <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" Margin="10,0"
                                    PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
                            <TextBlock x:Name="DurationText" Grid.Column="2" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE769;" Foreground="White" Click="PlayPause_Click" ToolTip="Lecture / Pause (Espace)"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Foreground="White" Click="Stop_Click" ToolTip="Arrêter"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RecBtn" Style="{StaticResource IconButton}" Click="Record_Click" ToolTip="Enregistrer (R)">
                                    <Ellipse x:Name="RecDot" Width="14" Height="14" Stroke="#F85149" StrokeThickness="2" Fill="Transparent"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8D6;" Foreground="White" Click="Audio_Click" ToolTip="Piste audio suivante"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE7F0;" Foreground="White" Click="Subs_Click" ToolTip="Sous-titres suivants"/>
                                <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE767;" Foreground="White" Click="Mute_Click" ToolTip="Muet (M)"/>
                                <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"
                                        ValueChanged="Volume_Changed" Margin="2,0,10,0"/>
                                <Button x:Name="FsBtn" Style="{StaticResource IconButton}" Content="&#xE740;" Foreground="White" Click="Fullscreen_Click" ToolTip="Plein écran (F)"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
