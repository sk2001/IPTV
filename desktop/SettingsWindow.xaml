<Window x:Class="IptvPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IptvPlayer.Localization"
        Title="{loc:T set.title}" Icon="Assets/app.ico" Width="680" Height="700" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26,32,10">
                <TextBlock Text="{loc:T set.title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:T set.note}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22"/>

                <TextBlock Text="{loc:T set.language}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:T set.language.desc}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="LanguageChips" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T set.audioVod}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:T set.audioVod.desc}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="AudioVodChips" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T set.subs}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:T set.subs.desc}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="SubVodChips" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T set.audioLive}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:T set.audioLive.desc}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="AudioLiveChips" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T set.resume}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:T set.resume.desc}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel x:Name="ResumeChips" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T set.history}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="HistoryInfo" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="{loc:T set.history.clear}" Click="ClearHistory_Click" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>

                <TextBlock Text="{loc:T set.accounts}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="{loc:T main.manageAccounts}" Click="Accounts_Click"/>
                </StackPanel>

                <TextBlock Text="{loc:T rem.section}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="{loc:T rem.open}" Click="Remote_Click"/>
                    <Button Content="{loc:T share.open}" Click="Share_Click" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{loc:T set.about}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="AboutText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{loc:T set.licenses}" Click="Licenses_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <Button Content="{loc:T set.close}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="100" IsDefault="True" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
