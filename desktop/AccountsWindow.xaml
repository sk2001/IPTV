<Window x:Class="IptvPlayer.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IptvPlayer.Localization"
        Title="{loc:T acc.title}" Icon="Assets/app.ico" Width="820" Height="560" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,14">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T acc.mine}" FontSize="16" FontWeight="SemiBold" Margin="18,0,18,10"/>
                <Button DockPanel.Dock="Bottom" Content="{loc:T acc.new}" Style="{StaticResource AccentButton}" Margin="14,10,14,0" Click="New_Click"/>
                <ListBox x:Name="AccountList" SelectionChanged="AccountList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,22">
                <TextBlock x:Name="FormTitle" Text="{loc:T acc.formNew}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:T acc.name}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox"/>

                <TextBlock Text="{loc:T acc.type}" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="XtreamRadio" Content="{loc:T acc.xtream}" IsChecked="True" Margin="0,0,24,0" Checked="Type_Changed"/>
                    <RadioButton x:Name="M3uRadio" Content="{loc:T acc.m3u}" Checked="Type_Changed"/>
                </StackPanel>

                <TextBlock x:Name="UrlLabel" Text="{loc:T acc.urlXtream}" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="{loc:T acc.browse}" Margin="8,0,0,0" Visibility="Collapsed" Click="Browse_Click"/>
                </Grid>

                <StackPanel x:Name="CredsPanel">
                    <TextBlock Text="{loc:T acc.username}" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,5"/>
                    <TextBox x:Name="UserBox"/>
                    <TextBlock Text="{loc:T acc.password}" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,5"/>
                    <PasswordBox x:Name="PassBox"/>
                </StackPanel>

                <TextBlock x:Name="Message" Margin="0,16,0,0" TextWrapping="Wrap" MinHeight="20"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="TestBtn" Content="{loc:T acc.test}" Click="Test_Click" Margin="0,0,10,0" MinWidth="90"/>
                    <Button Content="{loc:T acc.save}" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,10,0" MinWidth="110"/>
                    <Button x:Name="DeleteBtn" Content="{loc:T acc.delete}" Click="Delete_Click" Margin="0,0,10,0" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
                    <Button Content="{loc:T acc.close}" Click="Close_Click" MinWidth="80"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
